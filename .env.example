# Set these as environment variables in Render (never commit real values).
OPENAI_API_KEY=replace-with-your-secret-key
AGENT_MODEL=gpt-4.1-mini
UI_MODEL=gpt-4.1-mini
# Recommended when your public website can incur OpenAI API costs.
# Add a separate passphrase and enter it into APilot's login field.
APP_ACCESS_KEY=choose-a-long-random-passphrase
